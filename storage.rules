rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: families/{familyId}/profile_photos/{userId}.jpg
    //
    // Read only requires being signed in, not proven family membership —
    // mirrors firestore.rules' own call on the /families/{familyId} doc
    // (any authenticated request may read it; the family ID already acts
    // as a shared secret, and there's no directory/listing endpoint that
    // leaks one). Write is keyed on Firebase Auth's own uid, so you can
    // only ever overwrite the file named after yourself — no need to ask
    // Firestore who's in which family just to decide that.
    match /families/{familyId}/profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        fileName == request.auth.uid + '.jpg' &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
